---
import { Image } from 'astro:assets';
import phi from '../assets/symphi-phi.png';
import { NAV, SITE } from '../config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-ink/70 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <Image src={phi} alt="" width={64} height={64} class="size-8 transition group-hover:drop-shadow-[0_0_10px_rgba(227,165,122,0.7)]" />
      <span class="font-display text-lg font-semibold tracking-tight">{SITE.name}</span>
    </a>

    <ul class="hidden items-center gap-1 sm:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'rounded-full px-4 py-2 text-sm transition',
                isActive(item.href) ? 'bg-white/10 text-paper' : 'text-muted hover:text-paper',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="ml-2">
        <a
          href={SITE.github}
          class="flex items-center gap-2 rounded-full border border-white/10 px-4 py-2 text-sm text-paper transition hover:border-copper-400/60 hover:text-copper-200"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.2 1.9 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg>
          GitHub
        </a>
      </li>
    </ul>

    <details class="group relative sm:hidden">
      <summary class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-paper hover:bg-white/10 [&::-webkit-details-marker]:hidden" aria-label="Menu">
        <svg class="size-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="hidden size-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </summary>
      <ul class="absolute right-0 mt-2 w-52 overflow-hidden rounded-2xl border border-white/10 bg-panel/95 p-2 shadow-2xl backdrop-blur-xl">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="block rounded-xl px-4 py-2.5 text-sm text-paper hover:bg-white/5">{item.label}</a>
            </li>
          ))
        }
        <li><a href={SITE.github} class="block rounded-xl px-4 py-2.5 text-sm text-copper-300 hover:bg-white/5">GitHub ↗</a></li>
      </ul>
    </details>
  </nav>
</header>
