---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-32 text-center sm:px-6">
    <p class="font-mono text-sm text-copper-300">error 404</p>
    <h1 class="text-glow mt-4 font-display text-5xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-4 font-mono text-sm text-muted">
      <span class="text-copper-300">$</span> cd ~<span class="cursor ml-0.5 text-copper-300">▍</span>
    </p>
    <a href="/" class="mt-10 rounded-full bg-copper-300 px-7 py-3 text-sm font-medium text-ink transition hover:bg-copper-200">Back home</a>
  </section>
</Base>
