---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GlitchLogo from '../components/GlitchLogo.astro';
import terminalLogo from '../assets/logo/symphi-terminal.svg';
import { SITE } from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const sections = [
  {
    href: '/about',
    title: 'About',
    text: 'Who we are and what we work on.',
    icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 0 1 14 0',
  },
  {
    href: '/publications',
    title: 'Publications',
    text: 'Papers, preprints and code.',
    icon: 'M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6',
  },
  {
    href: '/blog',
    title: 'Blog',
    text: 'Notes, updates and announcements.',
    icon: 'M4 20h4L19 9l-4-4L4 16zM14 6l4 4',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_70%)]"></div>
    <div class="halo pointer-events-none absolute top-1/3 left-1/2 h-[28rem] w-[56rem] max-w-[140vw] -translate-x-1/2 -translate-y-1/2 rounded-full bg-copper-500/20 blur-[120px]"></div>

    <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-20 text-center sm:px-6 sm:pt-24 sm:pb-28">
      <a
        href="/blog/hello-world"
        class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-4 py-1.5 font-mono text-xs text-muted transition hover:border-copper-400/50 hover:text-paper"
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-copper-400 opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-copper-400"></span>
        </span>
        symphi.github.io is live →
      </a>

      <div class="mx-auto mt-10 max-w-4xl">
        <GlitchLogo src={terminalLogo.src} width={terminalLogo.width} height={terminalLogo.height} alt={`${SITE.name} logo`} />
      </div>

      <h1 class="mt-12 font-mono text-2xl text-paper sm:text-4xl">
        <span class="text-copper-300">&gt;</span> hello, world<span class="cursor ml-1 text-copper-300">▍</span>
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-base text-muted sm:text-lg">
        This is the home of {SITE.name}. Our research, publications and notes will appear here soon.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/about"
          class="w-full rounded-full bg-copper-300 px-7 py-3 text-sm font-medium text-ink transition hover:bg-copper-200 hover:shadow-[0_0_30px_rgba(238,193,160,0.45)] sm:w-auto"
        >
          About us
        </a>
        <a
          href={SITE.github}
          class="w-full rounded-full border border-white/15 px-7 py-3 text-sm font-medium text-paper transition hover:border-copper-400/60 hover:bg-white/5 sm:w-auto"
        >
          View on GitHub ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Explore -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">Explore</h2>
      <p class="hidden font-mono text-xs text-muted sm:block">ls ~/symphi</p>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {
        sections.map((s) => (
          <a
            href={s.href}
            class="group relative overflow-hidden rounded-2xl border border-white/10 bg-panel p-6 transition hover:-translate-y-0.5 hover:border-copper-400/40"
          >
            <div class="pointer-events-none absolute -top-16 -right-16 size-40 rounded-full bg-copper-500/0 blur-2xl transition group-hover:bg-copper-500/20" />
            <div class="flex size-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] text-copper-300">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={s.icon} />
              </svg>
            </div>
            <h3 class="mt-5 font-display text-lg font-semibold">{s.title}</h3>
            <p class="mt-1.5 text-sm text-muted">{s.text}</p>
            <span class="mt-6 inline-flex items-center gap-1 font-mono text-xs text-copper-300">
              cd {s.href.slice(1)}
              <span class="transition group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Latest posts -->
  {
    posts.length > 0 && (
      <section class="mx-auto mt-24 max-w-6xl px-4 sm:px-6">
        <div class="flex items-end justify-between gap-4">
          <h2 class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">Latest from the blog</h2>
          <a href="/blog" class="text-sm text-copper-300 hover:text-copper-200">All posts →</a>
        </div>
        <ul class="mt-8 divide-y divide-white/5 border-y border-white/5">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}`} class="group flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-8">
                <time class="shrink-0 font-mono text-xs text-muted sm:w-28" datetime={p.data.date.toISOString()}>
                  {fmt(p.data.date)}
                </time>
                <span class="font-medium text-paper transition group-hover:text-copper-200">{p.data.title}</span>
                {p.data.description && <span class="text-sm text-muted sm:ml-auto">{p.data.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- CTA -->
  <section class="mx-auto mt-24 max-w-6xl px-4 sm:px-6">
    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-panel px-6 py-14 text-center sm:px-12">
      <div class="bg-grid pointer-events-none absolute inset-0 opacity-60 [mask-image:radial-gradient(ellipse_at_bottom,black,transparent_70%)]"></div>
      <div class="pointer-events-none absolute -bottom-32 left-1/2 h-64 w-[36rem] max-w-full -translate-x-1/2 rounded-full bg-copper-500/20 blur-3xl"></div>
      <div class="relative">
        <h2 class="font-display text-2xl font-semibold tracking-tight sm:text-4xl">Follow our work</h2>
        <p class="mx-auto mt-3 max-w-md text-muted">Code and projects from {SITE.name} live on GitHub.</p>
        <a
          href={SITE.github}
          class="mt-8 inline-flex rounded-full bg-paper px-7 py-3 text-sm font-medium text-ink transition hover:bg-copper-200"
        >
          github.com/SymPhi ↗
        </a>
      </div>
    </div>
  </section>
</Base>
