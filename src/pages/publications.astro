---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ComingSoon from '../components/ComingSoon.astro';
import { publications } from '../data/publications';

const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
---

<Base title="Publications" description="Publications from SymPhi.">
  <PageHeader eyebrow="publications" title="Publications" />

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {publications.length === 0 && <ComingSoon label="Publications coming soon." />}

    {
      years.map((year) => (
        <section class="grid gap-4 border-t border-white/5 py-10 md:grid-cols-[8rem_1fr]">
          <h2 class="font-mono text-sm text-copper-300">{year}</h2>
          <ul class="space-y-4">
            {publications
              .filter((p) => p.year === year)
              .map((p) => (
                <li class="rounded-2xl border border-white/10 bg-panel p-5 transition hover:border-copper-400/40">
                  <h3 class="font-display text-lg font-semibold leading-snug">{p.title}</h3>
                  <p class="mt-1.5 text-sm text-muted">{p.authors}</p>
                  <p class="mt-1 text-sm italic text-paper/80">{p.venue}</p>
                  {p.links && p.links.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {p.links.map((l) => (
                        <a
                          href={l.href}
                          class="rounded-full border border-white/10 px-3 py-1 font-mono text-xs text-copper-300 transition hover:border-copper-400/60 hover:text-copper-200"
                        >
                          {l.label}
                        </a>
                      ))}
                    </div>
                  )}
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
